{
	"name": "df_patients_1",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "br_patients",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sl_patients",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(each(match(type == 'string' && name != 'date_of_birth'\r",
				"), $$ = trim($$)),",
				"          date_of_birth = case(\r",
				"\r",
				"    /* ya esta en yyyy-MM-dd */\r",
				"    regexMatch(date_of_birth,'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    date_of_birth,\r",
				"\r",
				"    /* MM/dd/yyyy -> yyyy-MM-dd */\r",
				"    regexMatch(date_of_birth,'^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),\r",
				"    split(date_of_birth,'/')[3] + '-' +\r",
				"    split(date_of_birth,'/')[1] + '-' +\r",
				"    split(date_of_birth,'/')[2],\r",
				"\r",
				"    /* MM-dd-yy -> yyyy-MM-dd */\r",
				"    regexMatch(date_of_birth,'^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
				"\r",
				"    iif(\r",
				"        toInteger(split(date_of_birth,'-')[3]) <= 26,\r",
				"\r",
				"        '20' + split(date_of_birth,'-')[3] + '-' +\r",
				"        split(date_of_birth,'-')[1] + '-' +\r",
				"        split(date_of_birth,'-')[2],\r",
				"\r",
				"        iif(\r",
				"            toInteger(split(date_of_birth,'-')[3]) >= 38,\r",
				"\r",
				"            '19' + split(date_of_birth,'-')[3] + '-' +\r",
				"            split(date_of_birth,'-')[1] + '-' +\r",
				"            split(date_of_birth,'-')[2],\r",
				"\r",
				"            date_of_birth\r",
				"        )\r",
				"    ),\r",
				"\r",
				"    date_of_birth\r",
				")) ~> derivedColumn1",
				"derivedColumn1 derive(insurance_provider = case(\r",
				"    lower(insurance_provider) == 'aetna', 'Aetna',\r",
				"    lower(insurance_provider) == 'aetna inc.', 'Aetna',\r",
				"    lower(insurance_provider) == 'aetnaa', 'Aetna',\r",
				"\r",
				"    lower(insurance_provider) == 'blue cross', 'Blue Cross',\r",
				"    lower(insurance_provider) == 'bluecross', 'Blue Cross',\r",
				"    lower(insurance_provider) == 'blue-cross', 'Blue Cross',\r",
				"\r",
				"    lower(insurance_provider) == 'cigna', 'Cigna',\r",
				"    lower(insurance_provider) == 'cigna health', 'Cigna',\r",
				"\r",
				"    lower(insurance_provider) == 'medicaid', 'Medicaid',\r",
				"\r",
				"    lower(insurance_provider) == 'medicare', 'Medicare',\r",
				"    lower(insurance_provider) == 'medi-care', 'Medicare',\r",
				"\r",
				"    lower(insurance_provider) == 'self pay', 'Self Pay',\r",
				"    lower(insurance_provider) == 'self-pay', 'Self Pay',\r",
				"\r",
				"    lower(insurance_provider) == 'uhc', 'United Health',\r",
				"    lower(insurance_provider) == 'united health', 'United Health',\r",
				"    lower(insurance_provider) == 'unitedhealth', 'United Health',\r",
				"\r",
				"    insurance_provider\r",
				"),",
				"          email = iif(\r",
				"    instr(lower(email), '@') > 0,\r",
				"    regexReplace(replace(lower(email),' ',''),'[,;: -]com$','.com'),\r",
				"    iif(\r",
				"        instr(lower(email), ' at ') > 0,\r",
				"        regexReplace(replace(replace(lower(email),' at ','@'),' ',''),'[,;: -]com$','.com'),\r",
				"        toString(null())\r",
				"    )\r",
				"),",
				"          gender = case(\r",
				"    substring(lower(gender),0,1) == 'm', 'M',\r",
				"    substring(lower(gender),0,1) == 'f', 'F',\r",
				"    toString(null())\r",
				"),",
				"          phone = iif(\r",
				"    length(regexReplace(phone,'[^0-9]','')) < 7,\r",
				"    toString(null()),\r",
				"    '+' +\r",
				"    substring(regexReplace(phone,'[^0-9]',''),0,3) +\r",
				"    ' ' +\r",
				"    substring(regexReplace(phone,'[^0-9]',''),3)\r",
				"),",
				"          date_of_birth = \r",
				"regexReplace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"lower(date_of_birth),\r",
				"'jan','01'),\r",
				"'feb','02'),\r",
				"'mar','03'),\r",
				"'apr','04'),\r",
				"'may','05'),\r",
				"'jun','06'),\r",
				"'jul','07'),\r",
				"'aug','08'),\r",
				"'sep','09'),\r",
				"'oct','10'),\r",
				"'nov','11'),\r",
				"'dec','12')\r",
				",'[^0-9 -]','')) ~> derivedColumn2",
				"derivedColumn2 derive(patient_id = toInteger(patient_id),",
				"          date_of_birth = \r",
				"case(\r",
				"\r",
				"    /* yyyy-mm-dd */\r",
				"    regexMatch(date_of_birth,'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toDate(date_of_birth,'yyyy-MM-dd'),\r",
				"\r",
				"    /* dd-mm-yyyy */\r",
				"    regexMatch(date_of_birth,'^[0-9]{2}-[0-9]{2}-[0-9]{4}$'),\r",
				"    toDate(date_of_birth,'dd-MM-yyyy'),\r",
				"\r",
				"    /* mm dd yyyy */\r",
				"    regexMatch(date_of_birth,'^[0-9]{2} [0-9]{2} [0-9]{4}$'),\r",
				"    toDate(date_of_birth,'MM dd yyyy')\r",
				"\r",
				")) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth,",
				"          phone,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     )) ~> sink1"
			]
		}
	}
}