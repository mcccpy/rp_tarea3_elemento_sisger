{
	"name": "dfgl_fact_facturacion_7",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sl_billing",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gl_fact_facturacion",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          payment_date as date,",
				"          amount as decimal(12,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT a.billing_id,a.admission_id,b.paciente_key,b.departamento_key,c.servicio_cargo_key,a.payment_date,a.amount\\n FROM silver.billing a\\nJOIN gold.fact_admisiones b ON a.admission_id = b.admission_id_bk\\nJOIN gold.dim_servicio_cargo c ON a.charge_type = c.tipo_cargo AND a.payment_status = c.estado_pago\\n',",
				"     format: 'query') ~> source1",
				"source1 derive(payment_date = toInteger(\r",
				"    toString(year(payment_date)) +\r",
				"    lpad(toString(month(payment_date)),2,'0') +\r",
				"    lpad(toString(dayOfMonth(payment_date)),2,'0')\r",
				")) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          facturacion_key as long,",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          fecha_pago_key as integer,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id_bk = billing_id,",
				"          admission_id_bk = admission_id,",
				"          paciente_key,",
				"          departamento_key,",
				"          servicio_cargo_key,",
				"          fecha_pago_key = payment_date,",
				"          monto_facturado = amount",
				"     )) ~> sink1"
			]
		}
	}
}