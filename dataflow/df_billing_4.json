{
	"name": "df_billing_4",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "br_billing",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sl_billing",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(each(match(type=='string' && name != 'payment_date'), $$ = trim($$)),",
				"          payment_date = \r",
				"case(\r",
				"\r",
				"    /* ya esta en yyyy-MM-dd */\r",
				"    regexMatch(payment_date,'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    payment_date,\r",
				"\r",
				"    /* MM/dd/yyyy -> yyyy-MM-dd */\r",
				"    regexMatch(payment_date,'^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),\r",
				"    split(payment_date,'/')[3] + '-' +\r",
				"    split(payment_date,'/')[1] + '-' +\r",
				"    split(payment_date,'/')[2],\r",
				"\r",
				"    /* MM-dd-yy -> yyyy-MM-dd */\r",
				"    regexMatch(payment_date,'^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
				"\r",
				"    iif(\r",
				"        toInteger(split(payment_date,'-')[3]) <= 26,\r",
				"\r",
				"        '20' + split(payment_date,'-')[3] + '-' +\r",
				"        split(payment_date,'-')[1] + '-' +\r",
				"        split(payment_date,'-')[2],\r",
				"\r",
				"        iif(\r",
				"            toInteger(split(payment_date,'-')[3]) >= 38,\r",
				"\r",
				"            '19' + split(payment_date,'-')[3] + '-' +\r",
				"            split(payment_date,'-')[1] + '-' +\r",
				"            split(payment_date,'-')[2],\r",
				"\r",
				"            payment_date\r",
				"        )\r",
				"    ),\r",
				"\r",
				"    payment_date\r",
				")) ~> derivedColumn1",
				"derivedColumn1 derive(payment_status = upper(payment_status),",
				"          charge_type = upper(charge_type),",
				"          amount = regexReplace(\r",
				"    replace(amount,',',''),\r",
				"    '[^0-9.]',\r",
				"    ''\r",
				"),",
				"          payment_date = \r",
				"regexReplace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"lower(payment_date),\r",
				"'jan','01'),\r",
				"'feb','02'),\r",
				"'mar','03'),\r",
				"'apr','04'),\r",
				"'may','05'),\r",
				"'jun','06'),\r",
				"'jul','07'),\r",
				"'aug','08'),\r",
				"'sep','09'),\r",
				"'oct','10'),\r",
				"'nov','11'),\r",
				"'dec','12')\r",
				",'[^0-9 -]','')) ~> derivedColumn2",
				"derivedColumn2 derive(each(match(name == 'billing_id' || name == 'admission_id'\r",
				"), $$ = toInteger($$)),",
				"          amount = iif(\r",
				"    isNull(amount),\r",
				"    toDecimal('0.00',12,2),\r",
				"    toDecimal(amount,12,2)\r",
				"),",
				"          payment_date = case(\r",
				"\r",
				"    /* yyyy-mm-dd */\r",
				"    regexMatch(payment_date,'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toDate(payment_date,'yyyy-MM-dd'),\r",
				"\r",
				"    /* dd-mm-yyyy */\r",
				"    regexMatch(payment_date,'^[0-9]{2}-[0-9]{2}-[0-9]{4}$'),\r",
				"    toDate(payment_date,'dd-MM-yyyy'),\r",
				"\r",
				"    /* mm dd yyyy */\r",
				"    regexMatch(payment_date,'^[0-9]{2} [0-9]{2} [0-9]{4}$'),\r",
				"    toDate(payment_date,'MM dd yyyy')\r",
				"\r",
				")) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}