{
	"name": "df_admissions_2",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "br_admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sl_admissions",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"derivedColumn4 derive(each(match(type=='string' && name != 'admission_date' && name != 'discharge_date'\r",
				"), $$ = trim($$)),",
				"          each(match(name == 'admission_date' || name == 'discharge_date' && type == 'string'), $$ = \r",
				"\r",
				"case(\r",
				"\r",
				"    /* ya esta en yyyy-MM-dd */\r",
				"    regexMatch(toString($$),'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toString($$),\r",
				"\r",
				"    /* MM/dd/yyyy -> yyyy-MM-dd */\r",
				"    regexMatch(toString($$),'^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),\r",
				"    split(toString($$),'/')[3] + '-' +\r",
				"    split(toString($$),'/')[1] + '-' +\r",
				"    split(toString($$),'/')[2],\r",
				"\r",
				"    /* MM-dd-yy -> yyyy-MM-dd */\r",
				"    regexMatch(toString($$),'^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
				"\r",
				"    iif(\r",
				"        toInteger(split(toString($$),'-')[3]) <= 26,\r",
				"\r",
				"        '20' + split(toString($$),'-')[3] + '-' +\r",
				"        split(toString($$),'-')[1] + '-' +\r",
				"        split(toString($$),'-')[2],\r",
				"\r",
				"        iif(\r",
				"            toInteger(split(toString($$),'-')[3]) >= 38,\r",
				"\r",
				"            '19' + split(toString($$),'-')[3] + '-' +\r",
				"            split(toString($$),'-')[1] + '-' +\r",
				"            split(toString($$),'-')[2],\r",
				"\r",
				"            toString($$)\r",
				"        )\r",
				"    ),\r",
				"\r",
				"    toString($$)\r",
				"))) ~> derivedColumn1",
				"derivedColumn1 derive(department = case(\r",
				"    lower(department) == 'pediatrics', 'PEDIATRICS',\r",
				"    lower(department) == 'paediatrics', 'PEDIATRICS',\r",
				"    lower(department) == 'peds', 'PEDIATRICS',\r",
				"\r",
				"    lower(department) == 'emergency', 'EMERGENCY',\r",
				"    lower(department) == 'er', 'EMERGENCY',\r",
				"    lower(department) == 'emergancy', 'EMERGENCY',\r",
				"\r",
				"    lower(department) == 'gen surg', 'GENERAL SURGERY',\r",
				"    lower(department) == 'general surgery', 'GENERAL SURGERY',\r",
				"    lower(department) == 'generalsurgery', 'GENERAL SURGERY',\r",
				"\r",
				"    lower(department) == 'orthopaedics', 'ORTHOPEDICS',\r",
				"    lower(department) == 'orthopedics', 'ORTHOPEDICS',\r",
				"    lower(department) == 'ortho', 'ORTHOPEDICS',\r",
				"\r",
				"    lower(department) == 'neuro', 'NEUROLOGY',\r",
				"    lower(department) == 'neurology', 'NEUROLOGY',\r",
				"    lower(department) == 'nuerology', 'NEUROLOGY',\r",
				"\r",
				"    lower(department) == 'oncology', 'ONCOLOGY',\r",
				"    lower(department) == 'oncologyy', 'ONCOLOGY',\r",
				"    lower(department) == 'onco', 'ONCOLOGY',\r",
				"\r",
				"    lower(department) == 'cardiology', 'CARDIOLOGY',\r",
				"    lower(department) == 'cardiolgy', 'CARDIOLOGY',\r",
				"    lower(department) == 'cardio', 'CARDIOLOGY',\r",
				"\r",
				"    upper(department)\r",
				"),",
				"          each(match(name == 'admission_date' || name == 'discharge_date'), $$ = \r",
				"regexReplace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"replace(\r",
				"lower($$),\r",
				"'jan','01'),\r",
				"'feb','02'),\r",
				"'mar','03'),\r",
				"'apr','04'),\r",
				"'may','05'),\r",
				"'jun','06'),\r",
				"'jul','07'),\r",
				"'aug','08'),\r",
				"'sep','09'),\r",
				"'oct','10'),\r",
				"'nov','11'),\r",
				"'dec','12')\r",
				",'[^0-9 -]',''))) ~> derivedColumn2",
				"derivedColumn2 derive(each(match(name == 'admission_date' || name == 'discharge_date'), $$ = case(\r",
				"\r",
				"    /* yyyy-mm-dd */\r",
				"    regexMatch($$,'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toDate(toString($$),'yyyy-MM-dd'),\r",
				"\r",
				"    /* dd-mm-yyyy */\r",
				"    regexMatch($$,'^[0-9]{2}-[0-9]{2}-[0-9]{4}$'),\r",
				"    toDate(toString($$),'dd-MM-yyyy'),\r",
				"\r",
				"    /* mm dd yyyy */\r",
				"    regexMatch($$,'^[0-9]{2} [0-9]{2} [0-9]{4}$'),\r",
				"    toDate(toString($$),'MM dd yyyy')\r",
				"\r",
				")),",
				"          each(match(name == 'admission_id' || name == 'patient_id' || name == 'attending_doctor_id'), $$ = toInteger($$))) ~> derivedColumn3",
				"source1 derive(discharge_date = iif(\r",
				"    !isNull(discharge_date),\r",
				"    discharge_date,\r",
				"\r",
				"    iif(\r",
				"        !isNull(admission_date),\r",
				"        admission_date,\r",
				"        '1900-01-01'\r",
				"    )\r",
				"),",
				"          admission_date = iif(\r",
				"    !isNull(admission_date),\r",
				"    admission_date,\r",
				"\r",
				"    iif(\r",
				"        !isNull(discharge_date),\r",
				"        discharge_date,\r",
				"        '1900-01-01'\r",
				"    )\r",
				")) ~> derivedColumn4",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id,",
				"          patient_id,",
				"          admission_date,",
				"          discharge_date,",
				"          department,",
				"          attending_doctor_id",
				"     )) ~> sink1"
			]
		}
	}
}