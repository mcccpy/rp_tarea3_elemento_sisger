{
	"name": "dfgl_dim_paciente_2",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sl_patients",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gl_dim_paciente",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT patient_id,\\nfull_name,\\ngender,\\ndate_of_birth,\\nemail,\\naddress,\\ninsurance_provider FROM silver.patients',",
				"     format: 'query') ~> source1",
				"source1 derive(birth = case(\r",
				"    floor(monthsBetween(currentDate(), date_of_birth) / 12) <= 18, '0-18',\r",
				"    floor(monthsBetween(currentDate(), date_of_birth) / 12) <= 35, '19-35',\r",
				"    floor(monthsBetween(currentDate(), date_of_birth) / 12) <= 60, '36-60',\r",
				"    '60+'\r",
				"),",
				"          insurance_provider = iif (\r",
				"    isNull(insurance_provider),'Null',insurance_provider\r",
				")) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id_bk = patient_id,",
				"          nombre_completo = full_name,",
				"          genero = gender,",
				"          fecha_nacimiento = date_of_birth,",
				"          rango_etario = birth,",
				"          correo_electronico = email,",
				"          direccion = address,",
				"          proveedor_seguro = insurance_provider",
				"     )) ~> sink1"
			]
		}
	}
}